# Public addresses of the Maze Arena server (the Mac), as host:port.
# Read by scripts/join_*.sh / join_*.bat (players) and scripts/deploy_*.sh (server).
# PLAYIT_*: from the playit.gg dashboard (Tunnels); they don't change across restarts.
# WEB_URL: link for the browser version (Cloudflare quick tunnel to web/bridge.py), rewritten
#   by deploy_start.sh when that tunnel restarts.
# CLOUDFLARE_TCP: Cloudflare quick tunnel hostname, rewritten by deploy_start.sh each time
#   the tunnel restarts (it changes every time); players need cloudflared for it.
WEB_URL=https://safe-pierre-else-adaptation.trycloudflare.com
PLAYIT_UDP=
PLAYIT_TCP=
CLOUDFLARE_TCP=reporter-newsletters-pin-becoming.trycloudflare.com
